## 目标与 Flash（本板为 32MB NOR Flash）
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

## PSRAM：8MB Octal @80MHz（渐变背景 434KB + 字库 2MB 都放这里）
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
## 内部 RAM 要留一块给刷屏的 DMA 中转缓冲（466*50*2 ≈ 46KB）
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
## 普通 malloc 里 ≤16 KB 的块默认强制放内部 RAM；FLAC 曲目解码后内部只剩 20 KB，
## 屏幕 SPI 连 DMA 缓冲都分配不到（Draw bitmap failed: ESP_ERR_NO_MEM）。
## 降到 8 KB 让解码器等中等块走 PSRAM，给 DMA 留出余量。
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=8192

## 投屏要同时占：httpd(4) + SSDP + 拉流 + lwip 内部，默认 10 偏紧
CONFIG_LWIP_MAX_SOCKETS=12

## 拉流吞吐：默认 TCP 接收窗口 5760 B（4×MSS），一次 8 KB 的 read 要等好几个
## RTT 才填满，实测只有 ~130 KB/s；24 bit FLAC 投屏需要 200+ KB/s，直接掉到 0.5 倍速。
## 取 24 KB：一次 8 KB read 稳定在 ~20 ms（约 400 KB/s）。
## 注意别为了省内存把它压到 8 KB —— 实测 read 会涨到 36 ms，
## 生产速度掉到 0.77 倍实时，SQ 直接开始断续。
CONFIG_LWIP_TCP_WND_DEFAULT=24576
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16

## CPU / 系统
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

## 控制台：板载 Type-C 接的是 ESP32-S3 原生 USB（GPIO19/20）
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

## LVGL 字号（中文字形由 tiny_ttf + storage 里的 font-cjk.ttf 提供）
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_40=y

## 中文渲染：字体文件在 storage 分区，由 components/cjk_font 读进 PSRAM
CONFIG_LV_USE_TINY_TTF=y
CONFIG_LV_TINY_TTF_CACHE_GLYPH_CNT=256
CONFIG_LV_TINY_TTF_CACHE_KERNING_CNT=128
# 内置 64KB 内存池放不下字形缓存
# CONFIG_LV_USE_BUILTIN_MALLOC is not set
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_STDLIB_MALLOC=1

## SPIFFS：与 tools/pack_storage.ps1 的参数严格一致，
## 否则 21MB 分区挂载会返回 ESP_ERR_INVALID_ARG（页数超过 uint16）
CONFIG_SPIFFS_PAGE_SIZE=512
CONFIG_SPIFFS_OBJ_NAME_LEN=32
CONFIG_SPIFFS_META_LENGTH=4
CONFIG_SPIFFS_USE_MAGIC=y
CONFIG_SPIFFS_USE_MAGIC_LENGTH=y

## esp_audio_codec：本地 WAV（PCM / G711 / ADPCM）+ DLNA 投屏的 MP3 / FLAC。
## 实测 QQ 音乐投屏只推 audio/mpeg（mp3）和 audio/x-ogg（文件名是 .flac，实为 FLAC），
## 所以 MP3 与 FLAC 必开，其余解码器与容器解析器仍然关掉控制镜像体积。
CONFIG_AUDIO_DECODER_AAC_SUPPORT=n
CONFIG_AUDIO_DECODER_MP3_SUPPORT=y
CONFIG_AUDIO_DECODER_G711_SUPPORT=y
CONFIG_AUDIO_DECODER_AMRNB_SUPPORT=n
CONFIG_AUDIO_DECODER_AMRWB_SUPPORT=n
CONFIG_AUDIO_DECODER_FLAC_SUPPORT=y
CONFIG_AUDIO_DECODER_OPUS_SUPPORT=n
CONFIG_AUDIO_DECODER_VORBIS_SUPPORT=n
CONFIG_AUDIO_DECODER_ADPCM_SUPPORT=y
CONFIG_AUDIO_DECODER_ALAC_SUPPORT=n
CONFIG_AUDIO_DECODER_PCM_SUPPORT=y
CONFIG_AUDIO_DECODER_SBC_SUPPORT=n
CONFIG_AUDIO_DECODER_LC3_SUPPORT=n
CONFIG_AUDIO_DECODER_G722_SUPPORT=n
CONFIG_AUDIO_SIMPLE_DEC_WAV_SUPPORT=y
CONFIG_AUDIO_SIMPLE_DEC_M4A_SUPPORT=n
CONFIG_AUDIO_SIMPLE_DEC_TS_SUPPORT=n
CONFIG_AUDIO_SIMPLE_DEC_OGG_SUPPORT=n
