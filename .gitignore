# node
node_modules/
npm-debug.log*

# build outputs that should be regenerated
dist/
*.bpk

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 注意：不要在这里写通用的 "build/"。
# xiaozhi-ui/build 是刻意入库的产物（ESP-Brookesia 在 CMake configure 阶段直接拷贝），
# 一旦父目录被忽略，git 无法再用 ! 规则恢复其内容。
# 固件工程请在该子目录内用局部 .gitignore 忽略 build/、sdkconfig 等。

# tools/pack_storage.ps1 的打包输出（storage.bin，20MB+）
/build/

# 镜像库源目录只留 README，二进制按需本地放置
storage_src/*.bin

