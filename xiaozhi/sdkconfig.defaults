## 目标与 Flash（本板为 32MB NOR Flash）
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

## PSRAM：8MB Octal @80MHz（Opus 编解码与 TLS 需要较大堆）
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
## 内部 RAM 必须留足：LVGL 双缓冲在 PSRAM，每次刷屏要在内部 RAM 分配
## 同尺寸的 DMA 中转缓冲（466*50*2 ≈ 46KB），mbedtls 也只用内部堆
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

## CPU / 系统
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

## 控制台：板载 Type-C 接的是 ESP32-S3 原生 USB（GPIO19/20）
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

## HTTPS：esp_xiaozhi 走 crt_bundle 校验 api.tenclass.net
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

## LVGL：界面用到的字号
## LVGL 只编库本体，示例与 demo 不参与编译（BSP 默认打开，浪费一半目标）
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n

CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_40=y

## 中文：LVGL 内置思源黑体 16px，只带 1195 个汉字，仅作 tiny_ttf 失败时的兜底
CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_16_CJK=y

## 中文主渲染：tiny_ttf 直接解析 main/assets/xz_cjk.ttf（GB2312 全集，2MB）
## 字形按需渲染并缓存，字号可调，不再受固定字表限制
CONFIG_LV_USE_TINY_TTF=y
CONFIG_LV_TINY_TTF_CACHE_GLYPH_CNT=512
CONFIG_LV_TINY_TTF_CACHE_KERNING_CNT=256

## LVGL 默认用内置 64KB 内存池，中文整屏文本 + 两档字号的字形缓存放不下，
## 改用系统堆（可选 PSRAM）
# CONFIG_LV_USE_BUILTIN_MALLOC is not set
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_STDLIB_MALLOC=1

## SPIFFS：中文字库在 storage 分区，参数必须和 tools/pack_storage.ps1 一致
## page 512：21MB / 256B = 86016 页，超过 spiffs_page_ix(uint16) 的 65535 上限，
## 用默认 256 会在 mount 时直接返回 ESP_ERR_INVALID_ARG
CONFIG_SPIFFS_PAGE_SIZE=512
CONFIG_SPIFFS_OBJ_NAME_LEN=32
CONFIG_SPIFFS_META_LENGTH=4
CONFIG_SPIFFS_USE_MAGIC=y
CONFIG_SPIFFS_USE_MAGIC_LENGTH=y
